---
import { getEntry, render } from 'astro:content';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Subscribe from '../components/Subscribe.astro';
import Youtube from '../components/Youtube.astro';
import { AileDanismanligiIframes } from '../data/externals';
import siteContent from '../data/site-content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRandomItems } from '../utils/post-utils.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, desc, navTitle, navText } = siteContent.aileDanismanligi;

const entry = await getEntry('info', 'aile-danismanligi');
const { Content } = await render(entry!);
---

<BaseLayout title={title} description={desc}>
    <div class="relative border-b border-slate-100 bg-slate-50" slot="header">
        <Header class="relative" />
        <PageHero {...siteContent.aileDanismanligi.hero} />
    </div>
    <section class="grow px-4 py-12 sm:px-8 sm:py-8">
        <Youtube frame={getRandomItems(AileDanismanligiIframes, 1)[0]} />
    </section>

    <section class="grow px-4 py-12 sm:px-8 sm:py-8">
        <article class="px-4 sm:px-8">
            <div class="mx-auto max-w-3xl">
                <div class="prose prose-slate sm:prose-lg max-w-none">
                    <Content />
                </div>
            </div>
        </article>
    </section>
    <section class="grow px-4 py-12 sm:px-8 sm:py-8">
        <Subscribe title={navTitle} text={navText} instagram={true} email={true} />
    </section>
</BaseLayout>
