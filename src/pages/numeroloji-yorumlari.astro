---
import Header from '../components/Header.astro';
import NumerolojiYorum from '../components/NumerolojiYorum.astro';
import PageHero from '../components/PageHero.astro';
import Subscribe from '../components/Subscribe.astro';
import siteContent, { numerolojiYorum } from '../data/site-content';
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, desc, navTitle, navText } = siteContent.numerolojiYorumlari;
---

<BaseLayout title={title} description={desc}>
    <div class="relative border-b border-slate-100 bg-slate-50" slot="header">
        <Header class="relative" />
        <PageHero {...siteContent.numerolojiYorumlari.hero} />
    </div>
    <section class="grow px-4 py-12 sm:px-8 sm:py-8">
        <Subscribe title={navTitle} text={navText} pranikYorum={true} />
    </section>
    <main class="grow px-4 py-12 sm:px-8 sm:py-16">
        <h1 class="sr-only">Blog</h1>
        <div class="mx-auto max-w-3xl xl:max-w-6xl">
            {numerolojiYorum.reverse().map((post) => <NumerolojiYorum yorum={post} />)}
        </div>
    </main>
    <section class="grow px-4 py-12 sm:px-8 sm:py-8">
        <Subscribe title={navTitle} text={navText} pranikYorum={true} />
    </section>
</BaseLayout>
