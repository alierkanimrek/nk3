---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';
import SocialLink from './SocialLink.astro';

const socialLinks = siteConfig.socialLinks ?? [];
const secondaryNavLinks = siteConfig.secondaryNavLinks ?? [];

const { title, text, avatar, backgroundImage } = Astro.props;
---

{
    (title || text || avatar?.src) && (
        <>
            {backgroundImage?.src && (
                <CustomImage
                    {...backgroundImage}
                    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-20"
                    sizes="100vw"
                    widths={[640, 960, 1280, 1600, 1920]}
                    fetchpriority="high"
                    loading="eager"
                />
            )}
            <section class="relative px-4 py-12 sm:px-8 sm:py-16">
                <div class="mx-auto flex w-full max-w-3xl flex-col items-center text-center">
                    {avatar?.src && (
                        <!--<div class="mb-6 p-6">
                            <CustomImage
                                {...avatar}
                                class="border-primary shadow-avatar aspect-square w-32 rounded-full border-2 object-cover"
                                width={128}
                                height={128}
                                widths={[128, 256]}
                                sizes="128px"
                                fetchpriority="high"
                                loading="eager"
                            />
                        </div>-->
                    )}
                    {title && <h1 class="text-4xl font-bold text-slate-900 sm:text-5xl">{title}</h1>}
                    {text && <p class:list={['text-slate-700 sm:text-lg', { 'mt-4': title }]}>{text}</p>}
                    {socialLinks.length > 0 && (
                        <div class="mx-auto mt-6 flex w-full max-w-3xl flex-wrap justify-center gap-x-4 gap-y-3">
                            {socialLinks.map((link) => (
                                <SocialLink {...link} class="hover:bg-primary hover:shadow-button bg-slate-50 text-slate-700 hover:text-white" />
                            ))}
                        </div>
                    )}
                </div>
            </section>
        </>
    )
}
